# ── Corebase self-host configuration ───────────────────────────────────────
# Copy to .env and fill in. Generate secrets with: openssl rand -base64 32

PROJECT_NAME=local

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=            # superuser; never hand this to an app
AUTHENTICATOR_PASSWORD=       # PostgREST login role
AUTH_DB_PASSWORD=             # auth module role
STORAGE_DB_PASSWORD=          # storage module role
ADMIN_DB_PASSWORD=            # corebase_admin, used by the dashboard's meta service
DB_MAX_CONNECTIONS=100
DB_SHARED_BUFFERS=256MB

# ── keys ───────────────────────────────────────────────────────────────────
# ES256 keypair (D-014). Generate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out jwt.key
#   openssl ec -in jwt.key -pubout -out jwt.pub
# Paste as single-line PEM with \n escapes, or mount as files and point at them.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Long-lived project keys, signed with the keypair above (D-029).
# Mint with: corebase keys mint --selfhost
ANON_KEY=
SERVICE_ROLE_KEY=

# ── URLs ───────────────────────────────────────────────────────────────────
API_PORT=8000
STUDIO_PORT=3000
POOLER_PORT=6543
SITE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
REDIRECT_ALLOWLIST=http://localhost:3000/**

# ── dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=           # basic auth on the studio port; put a real proxy in front

# ── object storage ─────────────────────────────────────────────────────────
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=corebase
S3_REGION=local
MAX_UPLOAD_MB=50

# ── mail ───────────────────────────────────────────────────────────────────
# Leave SMTP_HOST=mail and run `--profile dev` to catch mail in Mailpit.
# In production point these at a real provider (D-115).
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=auth@localhost
SIGNUPS_ENABLED=true

# ── operations ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL=3600
RATE_LIMIT_RPS=100
POOL_SIZE=20
POOL_MAX_CLIENTS=200
BACKUP_RETENTION_FULL=7
BACKUP_SCHEDULE_FULL=0 2 * * 0
BACKUP_SCHEDULE_DIFF=0 2 * * 1-6
