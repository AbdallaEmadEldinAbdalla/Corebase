{
  "name": "@corebase/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "bench": "node --experimental-strip-types bench/provision.mts",
    "kill-matrix": "node --experimental-strip-types kill-matrix/run.mts",
    "lifecycle": "node --experimental-strip-types bench/lifecycle.mts",
    "node-reboot": "node --experimental-strip-types bench/node-reboot.mts",
    "observability": "node --experimental-strip-types bench/observability.mts",
    "test:unit": "vitest run --exclude '**/*.e2e.test.ts' --passWithNoTests",
    "pause-bench": "node --experimental-strip-types bench/pause.mts",
    "density": "node --experimental-strip-types bench/density.mts",
    "load": "node --experimental-strip-types bench/load.mts"
  },
  "dependencies": {
    "@corebase/types": "workspace:*",
    "@corebase/queue": "workspace:*",
    "pg": "^8.13.1",
    "@corebase/crypto": "workspace:*",
    "@corebase/email": "workspace:*",
    "@corebase/secrets": "workspace:*",
    "@corebase/metrics": "workspace:*",
    "@corebase/audit": "workspace:*",
    "@corebase/jwt": "workspace:*"
  },
  "devDependencies": {
    "@corebase/config": "workspace:*",
    "@corebase/api": "workspace:*",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "@types/pg": "^8.11.10",
    "fastify": "^5.0.0"
  },
  "exports": {
    ".": "./src/main.ts",
    "./*": "./src/*"
  }
}
