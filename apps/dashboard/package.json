{
  "name": "@steadhold/dashboard",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/guard-no-dev-server.mjs && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.e2e.test.ts' --passWithNoTests"
  },
  "dependencies": {
    "@steadhold/types": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "lucide-react": "^1.43.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
