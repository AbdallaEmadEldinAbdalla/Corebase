design-exports.zip

# node / build
node_modules/
dist/
.turbo/
*.tsbuildinfo

# local env
.env
selfhost/.env

# staging secrets: generated locally, never committed
infra/docker/staging/certs/
infra/docker/staging/kek.d/
infra/docker/staging/app-role.env
# The object-store endpoint and its keys (P3a). Discovered per environment and
# secret, so it is generated rather than committed.
infra/docker/staging/backup-store.env
infra/docker/staging/mail-sink.env
# The object store's self-signed TLS material — generated per environment.
infra/docker/staging/object-store-certs/
demo/auth/config.js

# k6 writes a raw summary per script per run. The curated record is
# p5f-latency.json, which the harness writes and which is worth a diff;
# these two are intermediate output and would churn on every run.
docs/14-roadmap/measurements/*.summary.json
